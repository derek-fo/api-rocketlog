datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole{
  customer
  sale
}

model User{
  id String @id @default(uuid())
  email String @unique
  password String

  role UserRole @default(customer)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}